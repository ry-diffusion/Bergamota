 	}
+	wl_pace("SMMU streams + DMA pool");
 	if (!wce_prepare()) {
 		wf_fail("SMMU or DMA pool not ready", 0);
 		return;
 	}
+	wl_pace("WLAN_CFG request");
 	wce_send_cfg();
 }
 
