+/* descriptor + our TX FIFO in the apps<->ge->host partition, then GLINK VERSION (was the tail of ms_ipc_setup) */
+static bool
+ge_setup(void)
+{
+	ge->features = GLINK_FEATURE_REUSE;
+	ge->node = 0;
+	uint32_t sz = 0;
+	ge->desc = ms_smem_alloc_p(0, ge->host, GLINK_DESC_ITEM, 32);
+	if (!ge->desc || ms_smem_item(0, ge->host, GLINK_DESC_ITEM, &sz) != ge->desc || sz != 32) {
+		printf("BERGAMOTA IPC: glink descriptor not usable (size %u)\n", sz);
+		return false;
+	}
+	ge->tx = ms_smem_alloc_p(0, ge->host, GLINK_TX_ITEM, GLINK_TX_SIZE);
+	if (!ge->tx || ms_smem_item(0, ge->host, GLINK_TX_ITEM, &sz) != ge->tx || sz < 1024 || (sz & 7)) {
+		printf("BERGAMOTA IPC: glink TX FIFO not usable (size %u)\n", sz);
+		return false;
+	}
+	ge->tx_len = sz;                        /* the item's own size, as qcom_smem_get() returns it */
+	wl_wr(wl.smem, ge->desc + 8, 0);        /* *rx_pipe->tail = 0 */
+	wl_wr(wl.smem, ge->desc + 4, 0);        /* *tx_pipe->head = 0 */
+	bool v = ipc_tx_cmd(G_VERSION, 1, ge->features);
+	printf("BERGAMOTA IPC: glink up: descriptor +%#x, TX FIFO +%#x (%u bytes), version 1 features %#x %s\n", ge->desc,
+	    ge->tx, ge->tx_len, ge->features, v ? "sent" : "NOT SENT");
+	return v;
+}
