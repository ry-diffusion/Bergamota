+/*
+ * 1144: downstream smblib_rerun_aicl() (smb-lib.c): vote max(ICL_STATUS - 25 mA, 25 mA), then drop the vote; each vote
+ * change makes smblib_set_icl_current() write USBIN_CURRENT_LIMIT_CFG. Same two writes here.
+ */
+static void
+sc_aicl_rerun(struct sc_snap *s)
+{
+	unsigned now = sc_now_s(), before = s->icl_stat * SC_STEP_MA;
+	uint8_t lo = s->icl_stat > 1 ? (uint8_t)(s->icl_stat - 1) : 1, hi = cs.applied_icl_raw;
+	int r = sc_set(R_ICL_CFG, &s->icl_cfg, lo);
+
+	cs.rr_last_s = now;
+	cs.rr_n++;
+	cs.rr_total++;
+	cs.rr_gap = false;
+	if (r >= 0 && sc_set(R_ICL_CFG, &s->icl_cfg, hi) < 0) {
+		(void)sc_set(R_ICL_CFG, &s->icl_cfg, hi);       /* one retry; else the next tick rewrites it */
+	}
+	cs.rr_chk = true;
+	cs.rr_chk_s = now + SC_RR_CHECK_S;
+	cs.event = true;
+	printf("BERGAMOTA CHARGER: AICL rerun %u/%u: icl_now %u mA, cfg %u -> %u -> %u mA%s\n", cs.rr_n, SC_RR_MAX, before,
+	    hi * SC_STEP_MA, lo * SC_STEP_MA, hi * SC_STEP_MA, r < 0 ? " (write failed)" : "");
+}
