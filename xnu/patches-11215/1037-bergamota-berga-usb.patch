+/*
+ * ---- berga: vendor interface 2 for the host tools (kernel 1037) ----
+ *
+ * tools/berga (CLI, desktop app, the web page over WebUSB) talks to this
+ * interface; protocol in docs/BERGA_USB.md. Frames ("BRG1", 20-byte header,
+ * JSON head, raw body) on bulk 0x03 OUT / 0x83 IN. The kernel answers HELLO,
+ * REBOOT and the log stream itself (they work with userland dead); every
+ * other request goes whole to /dev/berga, where the phone daemon (bergad)
+ * reads it and writes the response frame back. Policy (allowlists) lives in
+ * the daemon and on the host; this side only moves frames.
+ */
+#define BG_MAGIC        0x31475242u     /* "BRG1" */
+#define BG_HDR          20
+#define BG_MAX          65536           /* = UD_BG_BUF: one frame per transfer */
+#define BG_FIFO         (256 * 1024)
+#define BG_REQUEST      1
+#define BG_RESPONSE     2
+#define BG_EVENT        3
+#define BG_ERROR        4
+#define BG_FLAG_PAD     1
+#define BG_FLAG_MORE    2
+#define BG_OP_HELLO     0x0001
+#define BG_OP_REBOOT    0x0002
+#define BG_OP_LOG_START 0x0003
+#define BG_OP_LOG_STOP  0x0004
+
+struct bg_fifo {
+	uint8_t    *buf;
+	uint32_t    head, len;
+};
+
+static struct {
+	lck_mtx_t  *lock;           /* both FIFOs, dev_open */
+	struct bg_fifo tx;          /* whole frames to the host */
+	struct bg_fifo rx;          /* whole request frames for /dev/berga */
+	uint8_t    *asm_buf;        /* host transfers -> frames (ud_thread only) */
+	uint32_t    asm_len;
+	bool        tx_busy;        /* ud_thread only */
+	int         dev_open;
+	int         cmajor;
+	uint32_t    log_tag;        /* 0: no log stream */
+	uint64_t    log_pos;
+	uint32_t    frames_in, frames_out, to_daemon, drops;
+} bg;
+
+extern uint32_t bergamota_log_copy(uint64_t *pos, char *out, uint32_t max);
+extern uint64_t bergamota_log_position(void);
+extern int kernel_sysctlbyname(const char *name, void *oldp, size_t *oldlenp, void *newp, size_t newlen);
+
+static inline uint32_t
+bg_le32(const uint8_t *p)
+{
+	return (uint32_t)p[0] | (uint32_t)p[1] << 8 | (uint32_t)p[2] << 16 | (uint32_t)p[3] << 24;
+}
+
+static inline void
+bg_put32(uint8_t *p, uint32_t v)
+{
+	p[0] = (uint8_t)v; p[1] = (uint8_t)(v >> 8); p[2] = (uint8_t)(v >> 16); p[3] = (uint8_t)(v >> 24);
+}
+
+/* Whole frame length from its header; > BG_MAX for anything malformed. */
+static uint32_t
+bg_frame_len(const uint8_t *h)
+{
+	uint32_t hl = bg_le32(h + 12), bl = bg_le32(h + 16);
+	if (bg_le32(h) != BG_MAGIC || hl > BG_MAX || bl > BG_MAX) {
+		return BG_MAX + 1;
+	}
+	return BG_HDR + hl + bl + (h[5] & BG_FLAG_PAD);
+}
+
+static void
+bg_fifo_copy(struct bg_fifo *f, uint32_t at, uint8_t *mem, uint32_t n, bool in)
+{
+	at %= BG_FIFO;
+	uint32_t first = MIN(n, BG_FIFO - at);
+	if (in) {
+		memcpy(f->buf + at, mem, first);
+		memcpy(f->buf, mem + first, n - first);
+	} else {
+		memcpy(mem, f->buf + at, first);
+		memcpy(mem + first, f->buf, n - first);
+	}
+}
+
+/* bg.lock held */
+static bool
+bg_fifo_put(struct bg_fifo *f, const uint8_t *frame, uint32_t n)
+{
+	if (f->len + n > BG_FIFO) {
+		return false;
+	}
+	bg_fifo_copy(f, f->head + f->len, (uint8_t *)(uintptr_t)frame, n, true);
+	f->len += n;
+	return true;
+}
+
+/* bg.lock held: length of the first frame, 0 if none */
+static uint32_t
+bg_fifo_peek(struct bg_fifo *f)
+{
+	uint8_t h[BG_HDR];
+	if (f->len < BG_HDR) {
+		return 0;
+	}
+	bg_fifo_copy(f, f->head, h, BG_HDR, false);
+	return bg_frame_len(h);
+}
+
+/* bg.lock held */
+static void
+bg_fifo_take(struct bg_fifo *f, uint8_t *out, uint32_t n)
+{
+	bg_fifo_copy(f, f->head, out, n, false);
+	f->head = (f->head + n) % BG_FIFO;
+	f->len -= n;
+}
+
+/* A frame from the kernel itself (ud_thread only: one static build buffer). */
+static bool
+bg_send(uint8_t kind, uint8_t flags, uint16_t op, uint32_t tag, const char *head, const void *body, uint32_t bl)
+{
+	static uint8_t f[BG_MAX];
+	uint32_t hl = head ? (uint32_t)strlen(head) : 0;
+	uint32_t n = BG_HDR + hl + bl;
+	bool ok;
+
+	if (n + 1 > BG_MAX) {
+		return false;
+	}
+	if ((n % 512) == 0) {
+		flags |= BG_FLAG_PAD;   /* the transfer must end in a short packet */
+	}
+	bg_put32(f, BG_MAGIC);
+	f[4] = kind;
+	f[5] = flags;
+	f[6] = (uint8_t)op; f[7] = (uint8_t)(op >> 8);
+	bg_put32(f + 8, tag);
+	bg_put32(f + 12, hl);
+	bg_put32(f + 16, bl);
+	memcpy(f + BG_HDR, head, hl);
+	memcpy(f + BG_HDR + hl, body, bl);
+	if (flags & BG_FLAG_PAD) {
+		f[n++] = 0;
+	}
+	lck_mtx_lock(bg.lock);
+	ok = bg_fifo_put(&bg.tx, f, n);
+	lck_mtx_unlock(bg.lock);
+	if (!ok) {
+		bg.drops++;
+	}
+	return ok;
+}
+
+static void
+bg_error(uint16_t op, uint32_t tag, const char *msg)
+{
+	char head[160];
+	snprintf(head, sizeof(head), "{\"error\":\"%s\"}", msg);
+	bg_send(BG_ERROR, 0, op, tag, head, NULL, 0);
+}
+
+/* Copy for a JSON string: no quotes, backslashes or control characters. */
+static void
+bg_json_str(char *out, size_t size, const char *s)
+{
+	size_t i = 0;
+	for (; *s && i + 1 < size; s++) {
+		out[i++] = (*s == '"' || *s == '\\') ? '\'' : ((unsigned char)*s < 0x20 ? ' ' : *s);
+	}
+	out[i] = 0;
+}
+
+static void
+bg_reboot_thread(void *arg, wait_result_t wr __unused)
+{
+	int howto = (int)(uintptr_t)arg;
+	ud_sleep_ms(500);       /* let the response go out */
+	printf("BERGAMOTA USB: berga reboot request (howto 0x%x)\n", howto);
+	reboot_kernel(howto, NULL);
+}
+
+static void
+bg_reboot(uint16_t op, uint32_t tag, const uint8_t *body, uint32_t bl)
+{
+	char mode[16], head[64];
+	thread_t thread;
+	int howto = RB_AUTOBOOT;
+
+	if (bl == 0 || bl >= sizeof(mode)) {
+		bg_error(op, tag, "reboot mode: normal, fastboot, bergamota, recovery or poweroff");
+		return;
+	}
+	memcpy(mode, body, bl);
+	mode[bl] = 0;
+	if (!strcmp(mode, "poweroff")) {
+		howto = RB_HALT;        /* kernel 1036: PSCI SYSTEM_OFF */
+	} else if (!strcmp(mode, "normal") || !strcmp(mode, "fastboot") || !strcmp(mode, "bergamota") || !strcmp(mode, "recovery")) {
+		/* bergamota_reboot.c takes the reason from its sysctl ("fastboot" = ABL bootloader) */
+		if (kernel_sysctlbyname("kern.bergamota_reboot_mode", NULL, NULL, mode, strlen(mode) + 1) != 0) {
+			bg_error(op, tag, "kern.bergamota_reboot_mode refused the mode");
+			return;
+		}
+	} else {
+		bg_error(op, tag, "reboot mode: normal, fastboot, bergamota, recovery or poweroff");
+		return;
+	}
+	snprintf(head, sizeof(head), "{\"mode\":\"%s\"}", mode);
+	bg_send(BG_RESPONSE, 0, op, tag, head, NULL, 0);
+	if (kernel_thread_start(bg_reboot_thread, (void *)(uintptr_t)howto, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+
+/* One complete request frame from the host (ud_thread). */
+static void
+bg_dispatch(const uint8_t *f, uint32_t n)
+{
+	uint16_t op = (uint16_t)(f[6] | f[7] << 8);
+	uint32_t tag = bg_le32(f + 8), hl = bg_le32(f + 12), bl = bg_le32(f + 16);
+	const uint8_t *body = f + BG_HDR + hl;
+	char head[512], kver[200];
+	uint64_t ns;
+	bool ok;
+
+	if (f[4] != BG_REQUEST) {
+		bg.drops++;
+		return;
+	}
+	bg.frames_in++;
+	switch (op) {
+	case BG_OP_HELLO:
+		bg.log_tag = 0;         /* a new client: no stream left running for the old one */
+		absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+		bg_json_str(kver, sizeof(kver), version);
+		snprintf(head, sizeof(head), "{\"proto\":1,\"kernel\":\"%s\",\"uptime_ms\":%llu,\"daemon\":%s,"
+		    "\"max_frame\":%u,\"usb\":{\"rx\":%llu,\"tx\":%llu,\"resets\":%u}}",
+		    kver, ns / 1000000, bg.dev_open ? "true" : "false", BG_MAX, ud.rx_frames, ud.tx_frames, ud.resets);
+		bg_send(BG_RESPONSE, 0, op, tag, head, NULL, 0);
+		break;
+	case BG_OP_REBOOT:
+		bg_reboot(op, tag, body, bl);
+		break;
+	case BG_OP_LOG_START: {
+		uint64_t backlog = 0, pos = bergamota_log_position();
+		for (uint32_t i = 0; i < bl && i < 10 && body[i] >= '0' && body[i] <= '9'; i++) {
+			backlog = backlog * 10 + (body[i] - '0');
+		}
+		backlog = MIN(backlog, 256 * 1024);
+		bg.log_pos = pos > backlog ? pos - backlog : 0;
+		bg.log_tag = tag;
+		snprintf(head, sizeof(head), "{\"position\":%llu}", bg.log_pos);
+		bg_send(BG_RESPONSE, 0, op, tag, head, NULL, 0);
+		break;
+	}
+	case BG_OP_LOG_STOP:
+		bg.log_tag = 0;
+		bg_send(BG_RESPONSE, 0, op, tag, NULL, NULL, 0);
+		break;
+	default:
+		if (op < 0x100) {
+			bg_error(op, tag, "unknown kernel op");
+			break;
+		}
+		lck_mtx_lock(bg.lock);
+		ok = bg.dev_open && bg_fifo_put(&bg.rx, f, n);
+		lck_mtx_unlock(bg.lock);
+		if (ok) {
+			bg.to_daemon++;
+			wakeup(&bg.rx);
+		} else {
+			bg_error(op, tag, bg.dev_open ? "phone busy (daemon queue full)" : "no daemon: bergad is not running on the phone");
+		}
+		break;
+	}
+}
+
+static void
+bg_rx_arm(void)
+{
+	ud_start_trb(EP_BG_RX, UD_TRB_BG_RX, UD_BG_RX, UD_BG_BUF, TRBCTL_NORMAL);
+}
+
+/* Bulk OUT done: reassemble frames (a transfer normally holds exactly one). */
+static void
+bg_rx_done(void)
+{
+	volatile uint32_t *t = (volatile uint32_t *)(ud.dma + UD_TRB_BG_RX);
+	ud_sync(UD_TRB_BG_RX, 16);
+	uint32_t len = UD_BG_BUF - (t[2] & 0xffffff);
+	ud_sync(UD_BG_RX, UD_BG_BUF);
+	if (bg.asm_len + len > BG_MAX) {
+		bg.asm_len = 0;         /* garbage: start over at the next transfer */
+		bg.drops++;
+	} else {
+		memcpy(bg.asm_buf + bg.asm_len, (const void *)(ud.dma + UD_BG_RX), len);
+		bg.asm_len += len;
+	}
+	while (bg.asm_len >= BG_HDR) {
+		uint32_t n = bg_frame_len(bg.asm_buf);
+		if (n > BG_MAX) {
+			bg.asm_len = 0;
+			bg.drops++;
+			break;
+		}
+		if (bg.asm_len < n) {
+			break;
+		}
+		bg_dispatch(bg.asm_buf, n);
+		memmove(bg.asm_buf, bg.asm_buf + n, bg.asm_len - n);
+		bg.asm_len -= n;
+	}
+	if (ud.configured) {
+		bg_rx_arm();
+	}
+}
+
+/* ud_thread: start the next queued frame on bulk IN, feed the log stream. */
+static void
+bg_poll(void)
+{
+	uint32_t n = 0;
+
+	if (bg.asm_buf == NULL || !ud.configured) {
+		return;
+	}
+	if (bg.log_tag) {
+		static char chunk[16384];
+		for (int i = 0; i < 8; i++) {
+			lck_mtx_lock(bg.lock);
+			bool room = BG_FIFO - bg.tx.len > sizeof(chunk) + BG_HDR + 1;
+			lck_mtx_unlock(bg.lock);
+			uint32_t got = room ? bergamota_log_copy(&bg.log_pos, chunk, sizeof(chunk)) : 0;
+			if (got == 0) {
+				break;
+			}
+			bg_send(BG_EVENT, BG_FLAG_MORE, BG_OP_LOG_START, bg.log_tag, NULL, chunk, got);
+		}
+	}
+	if (bg.tx_busy) {
+		return;
+	}
+	lck_mtx_lock(bg.lock);
+	n = bg_fifo_peek(&bg.tx);
+	if (n > BG_MAX) {               /* cannot happen: only whole, checked frames go in */
+		bg.tx.len = 0;
+		n = 0;
+	}
+	if (n) {
+		bg_fifo_take(&bg.tx, (uint8_t *)(ud.dma + UD_BG_TX), n);
+	}
+	lck_mtx_unlock(bg.lock);
+	if (!n) {
+		return;
+	}
+	wakeup(&bg.tx);                 /* room for a waiting writer */
+	bg.tx_busy = true;
+	bg.frames_out++;
+	ud_start_trb(EP_BG_TX, UD_TRB_BG_TX, UD_BG_TX, n, TRBCTL_NORMAL);
+	if (!ud.xfer_active[EP_BG_TX]) {
+		bg.tx_busy = false;     /* frame lost; the host times out */
+		bg.drops++;
+	}
+}
+
+/* Bus reset / disconnect: transfers are gone, so is any half-received frame. */
+static void
+bg_reset(void)
+{
+	bg.tx_busy = false;
+	bg.asm_len = 0;
+	bg.log_tag = 0;
+	if (bg.lock != NULL) {
+		lck_mtx_lock(bg.lock);
+		bg.tx.head = bg.tx.len = 0;
+		lck_mtx_unlock(bg.lock);
+		wakeup(&bg.tx);
+	}
+}
+
+/* SET_CONFIGURATION: the two bulk endpoints (TX FIFO 3). Failure leaves USB Ethernet working. */
+static void
+bg_configure(void)
+{
+	if (bg.asm_buf == NULL) {
+		return;
+	}
+	if (ud_epcmd(EP_BG_RX, DEPCMD_SETEPCONFIG, (2u << 1) | (512u << 3), (1u << 8) | ((uint32_t)EP_BG_RX << 25), 0) ||
+	    ud_epcmd(EP_BG_RX, DEPCMD_SETTRANSFRESOURCE, 1, 0, 0) ||
+	    ud_epcmd(EP_BG_TX, DEPCMD_SETEPCONFIG, (2u << 1) | (512u << 3) | (3u << 17), (1u << 8) | ((uint32_t)EP_BG_TX << 25), 0) ||
+	    ud_epcmd(EP_BG_TX, DEPCMD_SETTRANSFRESOURCE, 1, 0, 0)) {
+		printf("BERGAMOTA USB: berga endpoints setup failed\n");
+		ud_evlog(0xd0000009);   /* tag 9: berga endpoints setup failed */
+		return;
+	}
+	dwc_wr(DALEPENA, dwc_rd(DALEPENA) | (1u << EP_BG_RX) | (1u << EP_BG_TX));
+	bg_rx_arm();
+}
+
+/* ---- /dev/berga: the phone daemon's side (one opener, root only) ---- */
+
+static int
+bg_dev_open(__unused dev_t dev, __unused int flags, __unused int devtype, __unused struct proc *p)
+{
+	int err = 0;
+	lck_mtx_lock(bg.lock);
+	if (bg.dev_open) {
+		err = EBUSY;
+	} else {
+		bg.dev_open = 1;
+		bg.rx.head = bg.rx.len = 0;
+	}
+	lck_mtx_unlock(bg.lock);
+	return err;
+}
+
+static int
+bg_dev_close(__unused dev_t dev, __unused int flags, __unused int devtype, __unused struct proc *p)
+{
+	lck_mtx_lock(bg.lock);
+	bg.dev_open = 0;
+	lck_mtx_unlock(bg.lock);
+	wakeup(&bg.rx);
+	return 0;
+}
+
+/* One whole request frame per read; the buffer must hold BG_MAX bytes. */
+static int
+bg_dev_read(__unused dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	uint8_t *buf;
+	uint32_t n;
+	int err = 0;
+
+	if (uio_resid(uio) < BG_MAX) {
+		return EINVAL;
+	}
+	buf = kalloc_data(BG_MAX, Z_WAITOK);
+	if (buf == NULL) {
+		return ENOMEM;
+	}
+	lck_mtx_lock(bg.lock);
+	while ((n = bg_fifo_peek(&bg.rx)) == 0 && err == 0) {
+		err = msleep(&bg.rx, bg.lock, PZERO | PCATCH, "berga", NULL);
+	}
+	if (err == 0) {
+		bg_fifo_take(&bg.rx, buf, n);
+	}
+	lck_mtx_unlock(bg.lock);
+	if (err == 0) {
+		err = uiomove((const char *)buf, (int)n, uio);
+	}
+	kfree_data(buf, BG_MAX);
+	return err;
+}
+
+/* One whole response/event/error frame per write; waits up to 2 s for room (EAGAIN: nobody reads the host side). */
+static int
+bg_dev_write(__unused dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	user_ssize_t n = uio_resid(uio);
+	uint8_t *buf;
+	int err;
+
+	if (n < BG_HDR || n > BG_MAX) {
+		return EINVAL;
+	}
+	buf = kalloc_data(BG_MAX, Z_WAITOK);
+	if (buf == NULL) {
+		return ENOMEM;
+	}
+	err = uiomove((const char *)buf, (int)n, uio);
+	if (err == 0 && (bg_frame_len(buf) != (uint32_t)n || buf[4] < BG_RESPONSE || buf[4] > BG_ERROR)) {
+		err = EINVAL;
+	}
+	if (err == 0) {
+		struct timespec ts = { 2, 0 };
+		lck_mtx_lock(bg.lock);
+		while (err == 0 && !bg_fifo_put(&bg.tx, buf, (uint32_t)n)) {
+			err = msleep(&bg.tx, bg.lock, PZERO | PCATCH, "bergaw", &ts);
+		}
+		lck_mtx_unlock(bg.lock);
+		if (err == EWOULDBLOCK) {
+			err = EAGAIN;
+		}
+	}
+	kfree_data(buf, BG_MAX);
+	return err;
+}
+
+static const struct cdevsw bg_cdevsw = {
+	.d_open       = bg_dev_open,
+	.d_close      = bg_dev_close,
+	.d_read       = bg_dev_read,
+	.d_write      = bg_dev_write,
+	.d_ioctl      = eno_ioctl,
+	.d_stop       = eno_stop,
+	.d_reset      = eno_reset,
+	.d_ttys       = NULL,
+	.d_select     = eno_select,
+	.d_mmap       = eno_mmap,
+	.d_strategy   = eno_strat,
+	.d_reserved_1 = eno_getc,
+	.d_reserved_2 = eno_putc,
+	.d_type       = 0,
+};
+
+/* Gadget start, before the controller runs. Boot-arg bergamotaberga=0 leaves the interface without a backend. */
+static void
+bg_init(void)
+{
+	int on = 1;
+	PE_parse_boot_argn("bergamotaberga", &on, sizeof(on));
+	if (!on) {
+		return;
+	}
+	bg.lock = lck_mtx_alloc_init(lck_grp_alloc_init("bergamota_berga", LCK_GRP_ATTR_NULL), LCK_ATTR_NULL);
+	bg.tx.buf = kalloc_data(BG_FIFO, Z_WAITOK | Z_ZERO);
+	bg.rx.buf = kalloc_data(BG_FIFO, Z_WAITOK | Z_ZERO);
+	uint8_t *asm_buf = kalloc_data(BG_MAX, Z_WAITOK | Z_ZERO);
+	if (bg.lock == NULL || bg.tx.buf == NULL || bg.rx.buf == NULL || asm_buf == NULL) {
+		printf("BERGAMOTA USB: berga: no memory\n");
+		return;
+	}
+	bg.cmajor = cdevsw_add(-1, &bg_cdevsw);
+	if (bg.cmajor < 0) {
+		printf("BERGAMOTA USB: berga: no character device major\n");
+		return;
+	}
+	devfs_make_node(makedev(bg.cmajor, 0), DEVFS_CHAR, UID_ROOT, GID_WHEEL, 0600, "berga");
+	bg.asm_buf = asm_buf;   /* last: bg_poll/bg_configure run only once everything exists */
+	printf("BERGAMOTA USB: berga interface 2 (bulk 0x03/0x83), /dev/berga major %d\n", bg.cmajor);
+}
+
+/* kern.bergamota_berga: counters of the berga interface. */
+static int
+bg_stats_sysctl SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	char buf[256];
+	int n = snprintf(buf, sizeof(buf), "ready=%d daemon=%d log=%d in=%u out=%u to_daemon=%u drops=%u txbusy=%d txq=%u rxq=%u",
+	    bg.asm_buf != NULL, bg.dev_open, bg.log_tag != 0, bg.frames_in, bg.frames_out, bg.to_daemon, bg.drops,
+	    bg.tx_busy, bg.tx.len, bg.rx.len);
+	return SYSCTL_OUT(req, buf, MIN((size_t)n, sizeof(buf) - 1) + 1);
+}
+SYSCTL_PROC(_kern, OID_AUTO, bergamota_berga, CTLTYPE_STRING | CTLFLAG_RD | CTLFLAG_LOCKED, 0, 0, bg_stats_sysctl, "A",
+    "berga USB interface counters (kernel 1037)");
