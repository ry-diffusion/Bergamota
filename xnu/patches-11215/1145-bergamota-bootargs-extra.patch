@@ -2206,12 +2206,10 @@
 sysctl_sysctl_bootargs
 (__unused struct sysctl_oid *oidp, __unused void *arg1, __unused int arg2, struct sysctl_req *req)
 {
-	int error;
-	char buf[BOOT_LINE_LENGTH];
+	/* 1145: PE_boot_args() can be longer than BOOT_LINE_LENGTH (CommandLine + /chosen bergamota-bootargs-extra); read-only */
+	char *args = PE_boot_args();
 
