1157: Sandbox stand-in: container paths by code-signing ID (op 0xd) and by audit token (op 0x42); op 4 falls back to the
process's signing ID. 1155 alone never answered: a debug kernel (1156, not kept) showed RunningBoard launches multi-instance
extensions with the "Sandbox" spawn attrs (profile "plugin", 0x450 bytes) but container length 0 at +0xc, so nothing was recorded
and PlugInKit kept aborting (People widget intents every 1-2 s, ReportCrash busy). bergamotasbx (tools/bergamotanet, launchd job
org.bergamota.sbx at every boot) calls sandbox_set_container_path_for_signing_id(MCMMetadataIdentifier, container) for each
PluginKitPlugin data container (787 on this root); an extension's signing ID is its bundle ID. Table: 1024 entries, root only.
Op 0x42 (sandbox_set_container_path_for_audit_token {pid, pidversion, path}) stores into 1155's per-launch table.

diff --git a/bsd/kern/bergamota_amfi.c b/bsd/kern/bergamota_amfi.c
index 5050a56..d4ad2bd 100644
--- a/bsd/kern/bergamota_amfi.c
+++ b/bsd/kern/bergamota_amfi.c
@@ -396,7 +396,20 @@ bergamota_sandbox_container_expected(user_addr_t arg)
  * ("plugin has invalid sandbox or container"): intents, share sheets, Spotlight
  * indexers; chronod relaunched one every ~1.25 s. Keep the last 128 launches by
  * unique pid; ENOENT ("not in a container") for anything else, as before.
+ *
+ * Observed (kernel 1156): RunningBoard launches multi-instance extensions with
+ * profile "plugin" but no container in the spawn attrs, so two more sources:
+ * op 0x42 sandbox_set_container_path_for_audit_token {pid, pidversion, path}
+ * (containermanagerd's pushdown) and op 0xd sandbox_set_container_path_for_
+ * signing_id {signing id, path, ...}, which bergamotasbx (root) calls at boot
+ * for every PluginKitPlugin data container. Op 4 falls back to the process's
+ * code-signing identity (an extension's signing ID is its bundle ID, the
+ * container's MCMMetadataIdentifier).
  */
+#define BERGAMOTA_SBX_OP_SET_CONTAINER_SIGNING_ID 0xd
+#define BERGAMOTA_SBX_OP_SET_CONTAINER_TOKEN      0x42
+#define BERGAMOTA_SBX_SIGNING_IDS           1024
+#define BERGAMOTA_SBX_SIGNING_ID_MAX        128
 #define BERGAMOTA_SBX_OP_CONTAINER_PATH     4
 #define BERGAMOTA_SBX_ATTR_CONTAINER        0x50
 #define BERGAMOTA_SBX_CONTAINERS            128
@@ -408,9 +421,16 @@ static struct {
 	char path[BERGAMOTA_SBX_CONTAINER_MAX];
 } bergamota_sandbox_containers[BERGAMOTA_SBX_CONTAINERS];
 static unsigned bergamota_sandbox_container_next;
+static struct {
+	char id[BERGAMOTA_SBX_SIGNING_ID_MAX];
+	char path[BERGAMOTA_SBX_SIGNING_ID_MAX];
+} bergamota_sandbox_signing_ids[BERGAMOTA_SBX_SIGNING_IDS];
+static unsigned bergamota_sandbox_signing_id_count;
 static LCK_GRP_DECLARE(bergamota_sandbox_lck_grp, "bergamota_sandbox");
 static LCK_MTX_DECLARE(bergamota_sandbox_lock, &bergamota_sandbox_lck_grp);
 
+static void bergamota_sandbox_store(proc_t p, const char *c, size_t n);
+
 static int
 bergamota_sandbox_exec_container(kauth_cred_t old __unused, struct vnode *vp __unused, off_t offset __unused,
     struct vnode *scriptvp __unused, struct label *vnodelabel __unused, struct label *scriptvnodelabel __unused,
@@ -424,6 +444,13 @@ bergamota_sandbox_exec_container(kauth_cred_t old __unused, struct vnode *vp __u
 	if (n == 0 || n >= BERGAMOTA_SBX_CONTAINER_MAX || n == attrlen - BERGAMOTA_SBX_ATTR_CONTAINER || c[0] != '/') {
 		return 0;
 	}
+	bergamota_sandbox_store(p, c, n);
+	return 0;               /* no label transition */
+}
