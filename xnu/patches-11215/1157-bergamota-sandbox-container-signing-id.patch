+static void
+bergamota_sandbox_store(proc_t p, const char *c, size_t n)
+{
 	uint64_t uid = proc_uniqueid(p);
 	lck_mtx_lock(&bergamota_sandbox_lock);
 	unsigned i;
@@ -434,9 +461,9 @@ bergamota_sandbox_exec_container(kauth_cred_t old __unused, struct vnode *vp __u
 	}
 	bergamota_sandbox_containers[i].uniqueid = uid;
 	bergamota_sandbox_containers[i].pid = proc_pid(p);
-	memcpy(bergamota_sandbox_containers[i].path, c, n + 1);
+	memcpy(bergamota_sandbox_containers[i].path, c, n);
+	bergamota_sandbox_containers[i].path[n] = 0;
 	lck_mtx_unlock(&bergamota_sandbox_lock);
-	return 0;               /* no label transition */
 }
 
 static int
@@ -453,6 +480,9 @@ bergamota_sandbox_container_path(user_addr_t arg)
 		return ESRCH;
 	}
 	uint64_t uid = proc_uniqueid(p);
+	const char *sid = csproc_get_identity(p);
+	char sidbuf[BERGAMOTA_SBX_SIGNING_ID_MAX];
+	strlcpy(sidbuf, sid ? sid : "", sizeof(sidbuf));
 	proc_rele(p);
 	path[0] = 0;
 	lck_mtx_lock(&bergamota_sandbox_lock);
@@ -462,6 +492,11 @@ bergamota_sandbox_container_path(user_addr_t arg)
 			break;
 		}
 	}
+	for (unsigned i = 0; !path[0] && sidbuf[0] && i < bergamota_sandbox_signing_id_count; i++) {
+		if (strcmp(bergamota_sandbox_signing_ids[i].id, sidbuf) == 0) {
+			strlcpy(path, bergamota_sandbox_signing_ids[i].path, sizeof(path));
+		}
+	}
 	lck_mtx_unlock(&bergamota_sandbox_lock);
 	size_t n = strlen(path);
 	if (n == 0) {
@@ -473,6 +508,79 @@ bergamota_sandbox_container_path(user_addr_t arg)
 	return copyout(path, (user_addr_t)a[2], n + 1);
 }
 
+/* op 0xd {signing id, path, persona...}: root only; replaces an existing entry, ENOSPC when full */
+static int
+bergamota_sandbox_set_container_signing_id(user_addr_t arg)
+{
+	uint64_t a[2];
+	char id[BERGAMOTA_SBX_SIGNING_ID_MAX], path[BERGAMOTA_SBX_SIGNING_ID_MAX];
+	size_t idn = 0, pn = 0;
+	if (!kauth_cred_issuser(kauth_cred_get())) {
+		return EPERM;
+	}
+	int error = copyin(arg, a, sizeof(a));
+	if (!error) {
+		error = copyinstr((user_addr_t)a[0], id, sizeof(id), &idn);
+	}
+	if (!error) {
+		error = copyinstr((user_addr_t)a[1], path, sizeof(path), &pn);
+	}
+	if (error) {
+		return error == ENAMETOOLONG ? ERANGE : error;
+	}
+	if (idn <= 1 || path[0] != '/') {
+		return EINVAL;
+	}
+	lck_mtx_lock(&bergamota_sandbox_lock);
+	unsigned i;
+	for (i = 0; i < bergamota_sandbox_signing_id_count && strcmp(bergamota_sandbox_signing_ids[i].id, id) != 0; i++) {
+	}
+	if (i == BERGAMOTA_SBX_SIGNING_IDS) {
+		error = ENOSPC;
+	} else {
+		strlcpy(bergamota_sandbox_signing_ids[i].id, id, sizeof(id));
+		strlcpy(bergamota_sandbox_signing_ids[i].path, path, sizeof(path));
+		if (i == bergamota_sandbox_signing_id_count) {
+			bergamota_sandbox_signing_id_count++;
+		}
+	}
+	lck_mtx_unlock(&bergamota_sandbox_lock);
+	return error;
+}
+
+/* op 0x42 {pid, pidversion, path}: the container of one running process (root only) */
+static int
+bergamota_sandbox_set_container_token(user_addr_t arg)
+{
+	uint64_t a[3];
+	char path[BERGAMOTA_SBX_CONTAINER_MAX];
+	size_t pn = 0;
+	if (!kauth_cred_issuser(kauth_cred_get())) {
+		return EPERM;
+	}
+	int error = copyin(arg, a, sizeof(a));
+	if (!error) {
+		error = copyinstr((user_addr_t)a[2], path, sizeof(path), &pn);
+	}
+	if (error) {
+		return error == ENAMETOOLONG ? ERANGE : error;
+	}
+	if (pn <= 1 || path[0] != '/') {
+		return EINVAL;
+	}
+	proc_t p = proc_find((int)a[0]);
+	if (p == PROC_NULL) {
+		return ESRCH;
+	}
+	if (a[1] == 0 || proc_pidversion(p) == (int)a[1]) {
+		bergamota_sandbox_store(p, path, pn - 1);
+	} else {
+		error = ESRCH;
+	}
+	proc_rele(p);
+	return error;
+}
+
 static int
 bergamota_sandbox_syscall(struct proc *p, int call, user_addr_t arg)
 {
@@ -491,6 +599,10 @@ bergamota_sandbox_syscall(struct proc *p, int call, user_addr_t arg)
 		return bergamota_sandbox_container_expected(arg);
 	case BERGAMOTA_SBX_OP_CONTAINER_PATH:
 		return bergamota_sandbox_container_path(arg);
+	case BERGAMOTA_SBX_OP_SET_CONTAINER_SIGNING_ID:
+		return bergamota_sandbox_set_container_signing_id(arg);
+	case BERGAMOTA_SBX_OP_SET_CONTAINER_TOKEN:
+		return bergamota_sandbox_set_container_token(arg);
 	default:
 		return 0;
 	}
