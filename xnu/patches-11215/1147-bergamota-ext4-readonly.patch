+/*
+ * ---- 1147: the SLPI's data files, read-only. They live in Android partitions the kernel can reach by name: persist (ext4,
+ * sensors/registry = calibration), dsp (ext4, sdsp/ = the SLPI user-PD libraries) and vendor, a logical partition inside
+ * `super` (etc/sensors/config/*.json, etc/sensors/sns_reg_config). tools/ext4test is the host test of the reader.
+ * Nothing here ever writes to a partition. bergamotaslpifs=0 skips the listing in stage 1.
+ */
+#include "bergamota_ext4.h"
+
+struct sl_vol {
+	const char *part;               /* persist | dsp | vendor */
+	struct e4_dev raw, dev;
+	struct lp_view lp;
+	struct e4_fs fs;
+	bool mounted;
+};
+
+static int
+sl_part_read(void *ctx, uint64_t off, void *dst, uint64_t len)
+{
+	return bergamota_ufs_read_part((const char *)ctx, off, dst, len);
+}
+
+static int
+sl_vol_open(struct sl_vol *v, const char *part)
+{
+	memset(v, 0, sizeof(*v));
+	v->part = part;
+	if (strcmp(part, "vendor") != 0) {
+		v->raw.read = sl_part_read;
+		v->raw.ctx = (void *)(uintptr_t)part;
+		v->dev = v->raw;
+	} else {
+		static const char *const names[] = { "vendor", "vendor_a", "vendor_b" };
+		v->raw.read = sl_part_read;
+		v->raw.ctx = (void *)(uintptr_t)"super";
+		v->lp.base = &v->raw;
+		int err = ENOENT;
+		for (unsigned i = 0; i < 3 && err == ENOENT; i++) {
+			unsigned n = 0;
+			err = lp_find(&v->raw, names[i], v->lp.ext, 8, &n);
+			v->lp.n = n;
+			if (!err) {
+				uint64_t mib = 0;
+				for (unsigned k = 0; k < n; k++) {
+					mib += v->lp.ext[k].sectors >> 11;
+				}
+				printf("BERGAMOTA SLPI: super: logical partition %s, %u extents, first sector %llu, %llu MiB\n", names[i], n,
+				    v->lp.ext[0].first_sector, mib);
+			}
+		}
+		if (err) {
+			printf("BERGAMOTA SLPI: super: no vendor logical partition (errno %d)\n", err);
+			return err;
+		}
+		v->dev.read = lp_read;
+		v->dev.ctx = &v->lp;
+	}
+	int err = e4_mount(&v->fs, &v->dev);
+	if (err) {
+		printf("BERGAMOTA SLPI: %s: not a readable ext4 (errno %d)\n", part, err);
+		return err;
+	}
+	v->mounted = true;
+	printf("BERGAMOTA SLPI: %s: ext4 block %u, %u groups, inode %u, incompat %#x, label \"%s\"%s\n", part, v->fs.bs,
+	    v->fs.ngroups, v->fs.inode_size, v->fs.incompat, v->fs.label, v->fs.dirty_journal ? ", JOURNAL NEEDS RECOVERY" : "");
+	return 0;
+}
+
+static void
+sl_vol_close(struct sl_vol *v)
+{
+	if (v->mounted) {
+		e4_unmount(&v->fs);
+		v->mounted = false;
+	}
+}
+
+#define SL_LS_MAX 192u
+static struct sl_ent {
+	char name[40];
+	uint32_t ino;
+	uint8_t type;
+} sl_ents[SL_LS_MAX];
+
+static int
+sl_ls_cb(const char *n, unsigned l, uint32_t ino, unsigned type, void *ctx)
+{
+	unsigned *cnt = ctx;
+	if ((l == 1 && n[0] == '.') || (l == 2 && n[0] == '.' && n[1] == '.')) {
+		return 0;
+	}
+	if (*cnt < SL_LS_MAX) {
+		memcpy(sl_ents[*cnt].name, n, MIN(l, 39u));
+		sl_ents[*cnt].name[MIN(l, 39u)] = 0;
+		sl_ents[*cnt].ino = ino;
+		sl_ents[*cnt].type = (uint8_t)type;
+	}
+	(*cnt)++;
+	return 0;
+}
+
+/* one directory (names and sizes, three per line), then its subdirectories down to `depth` more levels */
+static void
+sl_ls(struct sl_vol *v, const char *path, unsigned depth)
+{
+	struct e4_inode in;
+	int err = e4_lookup(&v->fs, path, &in);
+	if (err) {
+		printf("BERGAMOTA SLPI: %s:%s: errno %d\n", v->part, path, err);
+		return;
 	}
+	if ((in.mode & 0xf000) != 0x4000) {
+		printf("BERGAMOTA SLPI: %s:%s: file, %llu bytes\n", v->part, path, in.size);
+		return;
+	}
+	unsigned cnt = 0;
+	err = e4_readdir(&v->fs, &in, sl_ls_cb, &cnt);
+	unsigned n = MIN(cnt, SL_LS_MAX);
+	printf("BERGAMOTA SLPI: %s:%s/ %u entries%s (errno %d)\n", v->part, path, cnt, cnt > n ? ", first part shown" : "", err);
+	char line[200];
+	unsigned len = 0, on = 0, ndirs = 0;
+	uint64_t total = 0;
+	for (unsigned i = 0; i < n; i++) {
+		struct e4_inode ei;
+		bool dir = false;
+		uint64_t size = 0;
+		if (e4_get_inode(&v->fs, sl_ents[i].ino, &ei) == 0) {
+			dir = (ei.mode & 0xf000) == 0x4000;
+			size = ei.size;
+		}
+		if (dir) {
+			ndirs++;
+			len += (unsigned)snprintf(line + len, sizeof(line) - len, " %s/", sl_ents[i].name);
+		} else {
+			total += size;
+			len += (unsigned)snprintf(line + len, sizeof(line) - len, " %s:%llu", sl_ents[i].name, size);
+		}
+		len = MIN(len, (unsigned)sizeof(line) - 1);
+		if (++on == 3 || len > 120 || i + 1 == n) {
+			printf("BERGAMOTA SLPI:  %s\n", line);
+			len = on = 0;
+		}
+	}
+	printf("BERGAMOTA SLPI: %s:%s: %llu bytes in files, %u subdirectories\n", v->part, path, total, ndirs);
+	if (depth == 0 || ndirs == 0) {
+		return;
+	}
+	/* the entry table is shared: remember the names of the subdirectories first */
+	static char sub[16][40];
+	unsigned ns = 0;
+	for (unsigned i = 0; i < n && ns < 16; i++) {
+		struct e4_inode ei;
+		if (e4_get_inode(&v->fs, sl_ents[i].ino, &ei) == 0 && (ei.mode & 0xf000) == 0x4000) {
+			strlcpy(sub[ns++], sl_ents[i].name, sizeof(sub[0]));
+		}
+	}
+	for (unsigned i = 0; i < ns; i++) {
+		char child[200];
+		snprintf(child, sizeof(child), "%s/%s", path, sub[i]);
+		sl_ls(v, child, depth - 1);
+	}
 }
 
+static void
+sl_stat(struct sl_vol *v, const char *path)
+{
+	struct e4_inode in;
+	int err = e4_lookup(&v->fs, path, &in);
+	if (err) {
+		printf("BERGAMOTA SLPI: %s:%s: errno %d\n", v->part, path, err);
+	} else {
+		printf("BERGAMOTA SLPI: %s:%s: %s, %llu bytes\n", v->part, path, (in.mode & 0xf000) == 0x4000 ? "directory" : "file",
+		    in.size);
+	}
+}
+
+static void
+sl_fs_inventory(void)
+{
+	static struct sl_vol vol;
+	printf("BERGAMOTA SLPI: data files (read-only): persist, vendor (in super), dsp\n");
+	bergamota_log_sync();
+	if (sl_vol_open(&vol, "persist") == 0) {
+		sl_ls(&vol, "/", 0);
+		sl_ls(&vol, "/sensors", 3);
+		sl_stat(&vol, "/sensors/registry/registry");
+		sl_stat(&vol, "/sensors/registry/file1");
+		sl_stat(&vol, "/sensors/registry/file2");
+		sl_vol_close(&vol);
+	}
+	bergamota_log_sync();
+	if (sl_vol_open(&vol, "vendor") == 0) {
+		sl_ls(&vol, "/etc/sensors", 1);
+		sl_stat(&vol, "/etc/sensors/sns_reg_config");
+		sl_stat(&vol, "/etc/sensors/config/config_list.txt");
+		sl_vol_close(&vol);
+	}
+	bergamota_log_sync();
+	if (sl_vol_open(&vol, "dsp") == 0) {
+		sl_ls(&vol, "/", 0);
+		sl_ls(&vol, "/sdsp", 0);
+		sl_vol_close(&vol);
+	}
+	bergamota_log_sync();
+}
