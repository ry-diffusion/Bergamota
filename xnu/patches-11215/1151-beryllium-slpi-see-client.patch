+	uint32_t node, port;
+	uint64_t ms;
+} see_srv;
+static void see_rx(const uint8_t *p, uint32_t len);
+
 /* one complete QRTR packet from the SLPI (header parsing as ipc_qrtr_rx) */
 static void
 sl_qrtr_rx(const uint8_t *p, uint32_t len)
