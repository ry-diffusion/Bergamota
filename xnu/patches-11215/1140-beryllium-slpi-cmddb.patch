-		printf("BERGAMOTA SLPI: cmd-db %s %s %#x (errno %d)\n", sl_arc_res[i], err ? "lookup failed" : "address", addr, err);
+		unsigned levels = 0;
+		int err = bergamota_rpmh_lookup_arc(sl_arc_res[i], &addr, &levels);
+		printf("BERGAMOTA SLPI: cmd-db %s %s %#x, %u levels (errno %d)\n", sl_arc_res[i], err ? "lookup failed" : "ARC address",
