bergamota: power off on halt with PSCI SYSTEM_OFF

Shutdown from iOS and reboot(RB_HALT) end in PEHaltRestart(kPEHaltCPU); the platform
expert only handled restarts, so a halt printed "CPU halted" and spun with the phone on.
kPEHaltCPU / kPEUPSDelayHaltCPU now call PSCI SYSTEM_OFF (0x84000008) on the Poco F1.
diff --git a/bsd/dev/bergamota_reboot.c b/bsd/dev/bergamota_reboot.c
index d35f8b1..12a3cff 100644
--- a/bsd/dev/bergamota_reboot.c
+++ b/bsd/dev/bergamota_reboot.c
@@ -247,6 +247,15 @@ bergamota_reboot_halt(void)
 	}
 }
 
+/* PSCI SYSTEM_OFF (SMCCC 1.0): the secure firmware turns the PMIC off. Returns only if refused. */
+static void
+sr_psci_system_off(void)
+{
+	register uint64_t x0 __asm__("x0") = 0x84000008ULL;
+	__asm__ volatile ("smc #0" : "+r"(x0) : : "x1", "x2", "x3", "x4", "x5", "x6", "x7",
+	    "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "cc", "memory");
+}
+
 /* Thread context, after the SPMI driver can start. Idempotent. */
 void
 bergamota_reboot_init(void)
@@ -374,4 +383,20 @@ bergamota_reboot_restart(int panic_restart)
 	delay(2000 * 1000);
 	return -1;
 }
+/*
+ * Power off (halt: shutdown from iOS, reboot(RB_HALT)). Until 1036 a halt only printed
+ * "CPU halted" and spun with the phone on. Returns only if PSCI refused.
+ */
+int
+bergamota_reboot_poweroff(void)
+{
+	if (!bergamota_board_beryllium()) {
+		return -1;
+	}
+	printf("BERGAMOTA REBOOT: powering off (PSCI SYSTEM_OFF)\n");
+	sr_psci_system_off();
+	delay(2000 * 1000);
+	printf("BERGAMOTA REBOOT: PSCI SYSTEM_OFF returned, staying halted\n");
+	return -1;
+}
 #endif /* ARM64_BOARD_CONFIG_BERGAMOTA */
diff --git a/iokit/Kernel/arm/BergamotaPlatformExpert.cpp b/iokit/Kernel/arm/BergamotaPlatformExpert.cpp
index f71fd59..586a812 100644
--- a/iokit/Kernel/arm/BergamotaPlatformExpert.cpp
+++ b/iokit/Kernel/arm/BergamotaPlatformExpert.cpp
@@ -12,6 +12,7 @@
 
 extern "C" int bergamota_reboot_restart(int panic_restart);
 extern "C" void bergamota_reboot_note_panic(void);
+extern "C" int bergamota_reboot_poweroff(void);
 extern "C" void bergamota_reboot_halt(void);
 #include "../../../bsd/dev/bergamota_board.h"
 #include "../../../bsd/dev/bergamota_spmi.h"
@@ -47,7 +48,7 @@ BergamotaPlatformExpert::start(IOService *provider)
 }
 
 /*
- * Reset path (bsd/dev/bergamota_reboot.c, Poco F1: PS_HOLD + reboot reason).
+ * Reset path (bsd/dev/bergamota_reboot.c, Poco F1: PS_HOLD + reboot reason); halt = power off (PSCI SYSTEM_OFF, 1036).
  * Other boards, and every type not handled here, keep the stock behaviour.
  * Panics only reset with boot-arg bergamotareboot=bootloader or bergamotapanicreboot=1 (the helper checks).
  */
@@ -66,7 +67,9 @@ BergamotaPlatformExpert::haltRestart(unsigned int type)
 		(void)bergamota_reboot_restart(1);
 		break;
 	case kPEHaltCPU:
+	case kPEUPSDelayHaltCPU:
 		bergamota_reboot_halt();
+		(void)bergamota_reboot_poweroff();      /* 1036: PSCI SYSTEM_OFF; stays halted, watchdog off, if refused */
 		break;
 	case kPEPanicRestartCPU:
 		bergamota_reboot_note_panic();
