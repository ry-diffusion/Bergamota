+/* 1027: the queued swap becomes the pending one (fLock held; the pending one was just taken) */
+void
+AppleCLCD::promoteNext(void)
+{
+	if (!fNextValid || fDirty) {
+		return;
+	}
+	if (fLastTakenID != 0 && (int32_t)(get32(fNextRec, 0x50) - fLastTakenID) <= 0) {
+		/* older than what was just taken: never show it after a newer frame */
+		fSt.nextDropped++;
+		BergamotaSurface *old[4];
+		memcpy(old, fNextHold, sizeof(old));
+		bzero(fNextHold, sizeof(fNextHold));
+		fNextValid = false;
+		IOLockUnlock(fLock);
+		bergamota_hold_release(old);
+		IOLockLock(fLock);
+		return;
+	}
+	memcpy(fPending, fNextRec, BERGAMOTA_FB_SWAP_REC_SIZE);
+	memcpy(fPendHold, fNextHold, sizeof(fPendHold));
+	bzero(fNextHold, sizeof(fNextHold));
+	fPendFence = fNextFence;
+	fPendGate = fNextGate;
+	fPendAbs = fNextAbs;
+	fNextValid = false;
+	fDirty = true;
+}
