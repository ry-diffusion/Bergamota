diff --git a/bsd/kern/bergamota_amfi.c b/bsd/kern/bergamota_amfi.c
index 70f9f1f43397e00a82e82165b5bd6e782ac0af47..11f3ca8f4d2fb7b07e6cbecbcd5adda760e7a74b 100644
--- a/bsd/kern/bergamota_amfi.c
+++ b/bsd/kern/bergamota_amfi.c
@@ -272,10 +272,54 @@ bergamota_amfi_vnode_check_signature(struct vnode *vp, __unused struct label *label,
 	return 0;
 }
 
+/*
+ * Policy "Sandbox": libsystem_sandbox calls __mac_syscall("Sandbox", op,
+ * arg). Without a policy of that name every call fails with ENOPOLICY and
+ * launchd reports mach lookups as "error = 159: Sandbox restriction"
+ * (backboardd cannot reach mobilegestalt or iohideventsystem; tccd:
+ * "profile not found"). BERGAMOTA runs without a sandbox: operations succeed
+ * (checks allow, profile init is accepted); the few that must return
+ * data (container paths, extension tokens) fail with ENOENT. The first
+ * use of each operation number is logged.
+ */
+static uint64_t bergamota_sandbox_seen;
+
+static int
+bergamota_sandbox_syscall(struct proc *p, int call, __unused user_addr_t arg)
+{
+	if (call >= 0 && call < 64 && !(bergamota_sandbox_seen & (1ULL << call))) {
+		bergamota_sandbox_seen |= 1ULL << call;
+		char name[32];
+		proc_name(proc_pid(p), name, sizeof(name));
+		printf("BERGAMOTA Sandbox: %s op %d\n", name, call);
+	}
+	switch (call) {
+	case 4:         /* container path (audit token / pid) */
+	case 5:         /* extension issue */
+	case 6:         /* extension consume */
+	case 0x43:      /* container expected */
+		return ENOENT;
+	default:
+		return 0;
+	}
+}
+
 static const struct mac_policy_ops bergamota_amfi_mac_ops = {
 	.mpo_vnode_check_signature = bergamota_amfi_vnode_check_signature,
 };
 
+static const struct mac_policy_ops bergamota_sandbox_mac_ops = {
+	.mpo_policy_syscall = bergamota_sandbox_syscall,
+};
+
+static struct mac_policy_conf bergamota_sandbox_mac_conf = {
+	.mpc_name = "Sandbox",
+	.mpc_fullname = "BERGAMOTA permissive sandbox stand-in",
+	.mpc_ops = &bergamota_sandbox_mac_ops,
+};
+
+static mac_policy_handle_t bergamota_sandbox_mac_handle;
+
 static struct mac_policy_conf bergamota_amfi_mac_conf = {
 	.mpc_name = "BERGAMOTA AMFI",
 	.mpc_fullname = "BERGAMOTA built-in Mobile File Integrity",
@@ -293,5 +337,8 @@ bergamota_amfi_policy_register(void)
 	int error = mac_policy_register(&bergamota_amfi_mac_conf, &bergamota_amfi_mac_handle, NULL);
 	printf("BERGAMOTA AMFI: platform binary policy %s (%d)\n",
 	    error ? "NOT registered" : "registered", error);
+	error = mac_policy_register(&bergamota_sandbox_mac_conf, &bergamota_sandbox_mac_handle, NULL);
+	printf("BERGAMOTA Sandbox: permissive policy %s (%d)\n",
+	    error ? "NOT registered" : "registered", error);
 }
 #endif /* ARM64_BOARD_CONFIG_BERGAMOTA */
