 }
 
+static void
+sr_wdt_pet(void)
+{
+	if (sr_wdt && !sr_wdt_hang) {
+		sr_wdt[SR_WDT_RST / 4] = 1;
+		__asm__ volatile ("dsb sy" ::: "memory");
+	}
+}
+
+static void
+sr_wdt_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	for (;;) {
+		sr_wdt_pet();
+		(void)tsleep((void *)&sr_wdt, PZERO, "sweetwdt", hz * (int)MAX(1u, sr_wdt_secs / 4));
+	}
+}
+
+/* qcom_wdt_start(): disable, reset the count, bark = bite = N s, enable without the bark IRQ. */
+static void
+sr_wdt_start(void)
+{
+	thread_t thread;
+
+	sr_wdt = (volatile uint32_t *)ml_io_map(SR_WDT_PA, 0x1000);
+	if (!sr_wdt) {
+		printf("SWEET REBOOT: watchdog NOT mapped\n");
+		return;
+	}
+	uint32_t was = sr_wdt[SR_WDT_EN / 4];
+	sr_wdt[SR_WDT_EN / 4] = 0;
+	sr_wdt[SR_WDT_RST / 4] = 1;
+	sr_wdt[SR_WDT_BARK / 4] = sr_wdt_secs * SR_WDT_HZ;
+	sr_wdt[SR_WDT_BITE / 4] = sr_wdt_secs * SR_WDT_HZ;
+	sr_wdt[SR_WDT_EN / 4] = 1;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	if (kernel_thread_start(sr_wdt_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+	printf("SWEET REBOOT: watchdog armed, bite after %u s, pet every %u s (EN was 0x%x, now 0x%x)\n",
+	    sr_wdt_secs, MAX(1u, sr_wdt_secs / 4), was, sr_wdt[SR_WDT_EN / 4]);
+}
+
+static int
+sr_test_sysctl SYSCTL_HANDLER_ARGS
+{
+#pragma unused(arg1, arg2)
+	int v = 0, error = sysctl_handle_int(oidp, &v, 0, req);
+	if (error || !req->newptr) {
+		return error;
+	}
+	if (v == 1) {
+		panic("SWEET REBOOT: test panic (kern.sweet_reboot_test=1)");
+	}
+	if (v == 2) {
+		if (!sr_wdt) {
+			return ENODEV;
+		}
+		printf("SWEET REBOOT: test hang: watchdog pets stopped, spinning with interrupts off\n");
+		sr_wdt_hang = true;
+		(void)ml_set_interrupts_enabled(FALSE);
+		for (;;) {
+		}
+	}
+	return EINVAL;
+}
+
+SYSCTL_PROC(_kern, OID_AUTO, sweet_reboot_test,
+    CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED, 0, 0, sr_test_sysctl, "I",
+    "write 1: test panic; 2: test hang (stop watchdog pets, spin with interrupts off)");
+
+/* Halt (no power-off path): keep the watchdog from turning it into a reboot. */
+void
+sweet_reboot_halt(void)
+{
+	if (sr_wdt) {
+		sr_wdt[SR_WDT_EN / 4] = 0;
+		__asm__ volatile ("dsb sy" ::: "memory");
+	}
+}
