-	    sr_imem ? "mapped" : "NOT mapped", sr_pon_ready ? "ready" : "unavailable");
+	    sr_imem ? "mapped" : "NOT mapped", sr_pon_ready ? "ready" : "unavailable",
+	    sr_bootarg == SR_BOOTLOADER ? "resets to fastboot" : sr_panic_reboot ? "resets (normal)" : "stays");
