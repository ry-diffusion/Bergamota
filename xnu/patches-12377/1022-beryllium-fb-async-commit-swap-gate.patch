+/*
+ * 1022: the swap gate for asynchronous Metal commits in backboardd (libm2v, /private/var/tmp/m2v-async-commit). The
+ * compositor's command buffer is submitted by an encode worker after CoreAnimation has already swapped, so the scan-out
+ * copy (a GPU blit queued at the swap) would run ahead of the frame's own GPU work and show an older frame. backboardd
+ * raises kern.bergamota_fb_gate_committed at each such commit and kern.bergamota_fb_gate_submitted once the worker has
+ * submitted it; a swap is taken only when the submits have caught up with the commits made before it (100 ms cap).
+ * Writes only ever raise a value (two threads write, their order is not kept). Both 0: no gate.
+ */
+uint64_t bergamota_fb_gate_committed, bergamota_fb_gate_submitted;
+static int
+sysctl_bergamota_fb_gate SYSCTL_HANDLER_ARGS
+{
+#pragma unused(arg2)
+	uint64_t *p = (uint64_t *)arg1, v = __atomic_load_n(p, __ATOMIC_ACQUIRE);
+	int err = sysctl_handle_quad(oidp, &v, 0, req);
+	if (err != 0 || req->newptr == USER_ADDR_NULL) {
+		return err;
+	}
+	uint64_t cur = __atomic_load_n(p, __ATOMIC_ACQUIRE);
+	while (v > cur && !__atomic_compare_exchange_n(p, &cur, v, false, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE)) {
+	}
+	return 0;
+}
+SYSCTL_PROC(_kern, OID_AUTO, bergamota_fb_gate_committed, CTLTYPE_QUAD | CTLFLAG_RW | CTLFLAG_ANYBODY | CTLFLAG_LOCKED,
+    &bergamota_fb_gate_committed, 0, sysctl_bergamota_fb_gate, "Q", "backboardd's async Metal commits (1022)");
+SYSCTL_PROC(_kern, OID_AUTO, bergamota_fb_gate_submitted, CTLTYPE_QUAD | CTLFLAG_RW | CTLFLAG_ANYBODY | CTLFLAG_LOCKED,
+    &bergamota_fb_gate_submitted, 0, sysctl_bergamota_fb_gate, "Q", "of those, submitted to the GPU (1022)");
+
 static unsigned int bergamota_fb_shot_scale = 3;
