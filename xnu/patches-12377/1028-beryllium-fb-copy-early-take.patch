+/* 1028: whether a flip queued by scanAddr() still waits for the MDP's latch (waitLatch() would spin on it) */
+bool
+AppleCLCD::latchPending(void)
+{
+	volatile uint32_t *flush = (volatile uint32_t *)(fMdp + BERGAMOTA_MDP_CTL0 + BERGAMOTA_MDP_CTL_FLUSH);
+	uint32_t mask = fLastFlush ? fLastFlush : (bergamota_mdp_pipes[fPipe].flush | BERGAMOTA_MDP_CTL_BIT);
+	return (*flush & mask) != 0;
+}
