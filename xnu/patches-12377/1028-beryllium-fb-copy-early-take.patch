+/*
+ * 1028: copy mode's early take (see fCopyEarly). Runs on the work loop, as the vsync tick does, so the two never present at
+ * once; it never waits: gates closed -> again in 250 us; the previous flip not latched yet -> again in 500 us (present()
+ * would spin in waitLatch() and hold up the vsync tick, which also wakes CoreAnimation's display link).
+ */
 void
+AppleCLCD::copyEarlyFired(OSObject *owner, IOTimerEventSource *)
+{
+	AppleCLCD *fb = (AppleCLCD *)owner;
+	BergamotaSurface *taken[4] = {};
+
+	if (fb->fPowerOff) {
+		return;
+	}
+	IOLockLock(fb->fLock);
+	if (!fb->fDirty) {
+		IOLockUnlock(fb->fLock);
+		return;
+	}
+	uint64_t now = mach_absolute_time();
+	if (!fb->submitGateOpen(now) || !fb->gpuGateOpen(now)) {
+		IOLockUnlock(fb->fLock);
+		fb->fCopyTimer->setTimeoutUS(250);
+		return;
+	}
+	if (fb->latchPending()) {
+		IOLockUnlock(fb->fLock);
+		fb->fCopyTimer->setTimeoutUS(500);
+		return;
+	}
+	uint8_t *rec = (uint8_t *)IOMallocData(BERGAMOTA_FB_SWAP_REC_SIZE);
+	if (rec == NULL) {
+		IOLockUnlock(fb->fLock);
+		return;         /* the vsync tick takes it */
+	}
+	memcpy(rec, fb->fPending, BERGAMOTA_FB_SWAP_REC_SIZE);
+	fb->fDirty = false;
+	memcpy(taken, fb->fPendHold, sizeof(taken));
+	bzero(fb->fPendHold, sizeof(fb->fPendHold));
+	IOLockUnlock(fb->fLock);
+	fb->present(rec);
+	IOFreeData(rec, BERGAMOTA_FB_SWAP_REC_SIZE);
+	bergamota_hold_release(taken);      /* copied: CA may render into them again */
+}
