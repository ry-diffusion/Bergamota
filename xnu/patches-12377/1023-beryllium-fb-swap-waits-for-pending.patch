+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -1093,6 +1093,7 @@
 		/* the frame's work is on the ring only now: the GPU gate (0229) waits for the fence taken here, not at the swap */
 		fPendGate = 0;
