+/* kern.bergamota_gpu_extreme: 1 = levels up to 835 MHz, 0 = the stock 710 MHz top (bergamotad sets 0 in Low Power Mode). */
+static int
+bergamota_gpu_extreme_sysctl SYSCTL_HANDLER_ARGS
+{
+#pragma unused(arg1, arg2)
+	int v = (int)a630_extreme, err = sysctl_handle_int(oidp, &v, 0, req);
+	if (err || req->newptr == USER_ADDR_NULL) {
+		return err;
+	}
+	if (v != 0 && v != 1) {
+		return EINVAL;
+	}
+	bergamota_gpu_lock();
+	a630_extreme = (uint32_t)v;
+	if (a630_awake && a630_level > gpu_cap()) {
+		(void)gpu_set_level(gpu_cap());
+	}
+	bergamota_gpu_unlock();
+	printf("BERGAMOTA GPU: Extreme Performance Mode %s (top level %u, %u MHz)\n", v ? "on" : "off", gpu_cap(),
+	    gpu_levels[gpu_cap()].mhz);
+	return 0;
+}
+SYSCTL_PROC(_kern, OID_AUTO, bergamota_gpu_extreme, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED, 0, 0, bergamota_gpu_extreme_sysctl, "I",
