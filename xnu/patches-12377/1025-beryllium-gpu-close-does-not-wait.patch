 /*
+ * 1025: GEM_CLOSE does not wait for the GPU. releaseGem() waits until the last submission that listed the BO is done,
+ * and Turnip lists every BO of its device in every submit, so a process freeing anything (a command stream at a pool
+ * reset, an imported surface) sat here until its frame in flight was drawn: in backboardd 133 closes of 3-28 ms in 24
+ * home-screen page swipes, on the threads that encode the next frame (libdrm's drm-slow.log, 2026-11-24). Now such a
+ * BO moves to the client's zombie list, its handle is free at once, and it is released at a later call once its
+ * fence has passed (Linux keeps the object alive the same way). With the list full, the old wait. Lock held.
+ */
+void
+BergamotaAdrenoUserClient::closeGem(struct bergamota_gem *g)
+{
+	reapZombies();
+	if (g->lastFence == 0 || bergamota_gpu_fence_done(g->lastFence) || !bergamota_gpu_ready() || fZombies == NULL ||
+	    fZombieN >= ZOMBIE_MAX) {
+		releaseGem(g);
+		return;
+	}
+	fZombies[fZombieN++] = *g;
+	bzero(g, sizeof(*g));
+	g->iova = IOVA_UNSET;
+}
+
+/* Releases the zombies whose last submission is done (or all of them when the GPU is gone: releaseGem leaks those). Lock held. */
+void
+BergamotaAdrenoUserClient::reapZombies(void)
+{
+	for (uint32_t i = 0; i < fZombieN;) {
+		if (bergamota_gpu_fence_done(fZombies[i].lastFence) || !bergamota_gpu_ready()) {
+			releaseGem(&fZombies[i]);
+			fZombies[i] = fZombies[--fZombieN];
+		} else {
+			i++;
+		}
+	}
+}
+
+/*
