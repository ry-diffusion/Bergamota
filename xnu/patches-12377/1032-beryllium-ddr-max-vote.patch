 /* bsd/dev/sweet_a630.c: the kept-up GPU. Not thread safe; this file holds gAdrenoLock around every call. */
@@ -221,6 +222,13 @@ SweetAdrenoPublish(void)
 			svc->registerService();
 			IOLog("SWEET GPU: %s published (user client class %s)\n", SWEET_GPU_SERVICE_NAME,
 			    agx ? "AGXDeviceUserClient" : "SweetAdrenoUserClient");
+			/* sweetddrmax=1: DDR and the memory NoC at their top level (kernel 1032); nothing else votes DDR,
