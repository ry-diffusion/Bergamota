diff --git a/bsd/dev/sweet_cpufreq.c b/bsd/dev/sweet_cpufreq.c
index 2460e6d08..0a021ef7c 100644
--- a/bsd/dev/sweet_cpufreq.c
+++ b/bsd/dev/sweet_cpufreq.c
@@ -60,6 +60,7 @@
  *                                      falls back to its base cap / boost ceiling in one step and the
  *                                      governor takes over. The GPU half is sweetgpuinput= /
  *                                      sweetgpuinputms= in sweet_a630.c.
+ *   sweetcores=<mask>                  recommended CPUs once all are up, e.g. 0xf1 (patch 1021; CPU0 always)
  *   sweetamp=0|1                       idle-core steering in the scheduler (default 1)
  *   sweetamp_prio=<n>                  base_pri threshold (default 31)
  * Core-class steering (independent of the cpufreq mode): once all CPUs are up,
@@ -103,6 +104,7 @@
 extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
 extern uint64_t sweet_processor_idle_time(int cpu);
 extern void sweet_amp_enable(uint64_t big, uint64_t little, int pri);
+extern void sched_perfcontrol_update_recommended_cores_reason(uint64_t, processor_reason_t, uint32_t);
 extern kern_return_t thread_terminate(thread_t);
 extern boolean_t sweet_cpu_signal_is_enabled(unsigned int cpu);
 extern void sweet_gpu_input_boost(uint64_t now);        /* bsd/dev/sweet_a630.c */
@@ -552,6 +554,17 @@ cf_thread(void *arg __unused, wait_result_t wr __unused)
 	if (cf_amp) {
 		cf_amp_setup();
 	}
+	/*
+	 * 1021: sweetcores=MASK makes only those CPUs "recommended" to the scheduler, what the DEVELOPMENT
+	 * sysctl kern.sched_update_recommended_cores does with enable_skstb (e.g. 0xf1 = CPU0 + the A75s, so
+	 * UI threads stop landing on the A55s). CPU0 always stays in. Numeric boot-arg: parsed as an int.
+	 */
+	uint64_t cores = 0;
+	if (PE_parse_boot_argn("sweetcores", &cores, sizeof(cores)) && cores) {
+		cores |= 1;
+		sched_perfcontrol_update_recommended_cores_reason(cores, REASON_CLPC_USER, 0);
+		printf("SWEET CPUFREQ: recommended cores 0x%llx (sweetcores)\n", cores);
+	}
 	if (cf_mode == MODE_OFF) {
 		goto out;
 	}
