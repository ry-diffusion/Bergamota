+/* Ring of device events and driver tags for kern.sweet_usb_log (tags: 0xd0000000 | n, see ud_tag callers). */
+static void
+ud_evlog(uint32_t v)
+{
+	uint64_t ns;
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	uint32_t i = ud.evlog_n++ % 64;
+	ud.evlog[i][0] = (uint32_t)(ns / 1000000);
+	ud.evlog[i][1] = v;
+}
