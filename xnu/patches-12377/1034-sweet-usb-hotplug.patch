+static uint64_t
+ud_ms_since(uint64_t t)
+{
+	uint64_t ns;
+	absolutetime_to_nanoseconds(mach_absolute_time() - t, &ns);
+	return ns / 1000000;
+}
+
+/* Bus resumed after a host suspend (sleep): announce the link again, restart a stalled send. */
+static void
+ud_resumed(const char *why)
+{
+	ud.suspended = false;
+	ud.wakeups++;
+	ud.resume_at = mach_absolute_time();
+	printf("SWEET USB: resume (%s), configured %d alt %u\n", why, ud.configured, ud.data_alt);
+	if (ud.configured && ud.data_alt == 1 && !ud.xfer_active[EP_INT]) {
+		ud_notify_connected();
+	}
+	lck_mtx_lock(ud.lock);
+	ud_tx_kick_locked();
+	lck_mtx_unlock(ud.lock);
+}
