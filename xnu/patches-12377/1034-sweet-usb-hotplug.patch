 				ud_event(ev);
 			}
 			dwc_wr(GEVNTCOUNT, count);
 		}
+		if ((ticks % 100) == 0) {
+			ud_watch();
+		}
 		if ((++ticks % 30000) == 0) {
 			volatile uint32_t *rx = (volatile uint32_t *)(ud.dma + UD_TRB_RX);
 			volatile uint32_t *tx = (volatile uint32_t *)(ud.dma + UD_TRB_TX);
@@ -1307,8 +1457,11 @@ sweet_usb_gadget_start(vm_offset_t dwc)
 	}
 	dwc_wr(DCFG, dcfg);
 	printf("SWEET USB: DCFG 0x%08x (DEVSPD %u)\n", dwc_rd(DCFG), dwc_rd(DCFG) & 7u);
-	/* Events: disconnect, USB reset, connect done */
-	dwc_wr(DEVTEN, 0x7);
+	/* Events: disconnect, USB reset, connect done, link state change, wakeup, suspend, erratic error (1034) */
+	dwc_wr(DEVTEN, 0x7 | (1u << 3) | (1u << 4) | (1u << 6) | (1u << 9));
+	ud.watch = 1;
+	PE_parse_boot_argn("sweetusbwatch", &ud.watch, sizeof(ud.watch));
+	ud.last_rx = mach_absolute_time();
 
 	/* Endpoint 0 OUT/IN: start config, control type, max packet 512 until connect done. */
 	if (ud_epcmd(0, DEPCMD_DEPSTARTCFG, 0, 0, 0) ||
@@ -1348,4 +1501,37 @@ sweet_usb_gadget_start(vm_offset_t dwc)
 		thread_deallocate(thread);
