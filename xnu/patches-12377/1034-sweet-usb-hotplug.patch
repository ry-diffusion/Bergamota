+/*
+ * Soft disconnect + reconnect (Linux dwc3 pullup off/on without the core reset beryllium cannot take): the pull-up goes
+ * away for 300 ms, so the host sees an unplug and enumerates the phone from scratch (reset, SET_CONFIGURATION,
+ * SET_INTERFACE, NETWORK_CONNECTION). Runs on ud_thread, between event batches.
+ */
+static void
+ud_soft_reconnect(const char *why)
+{
+	int i;
+	ud.reconnects++;
+	printf("SWEET USB: soft reconnect #%u (%s)\n", ud.reconnects, why);
+	ud_bus_reset("soft disconnect");
+	dwc_wr(DCTL, dwc_rd(DCTL) & ~DCTL_RUN_STOP);
+	for (i = 0; i < 500 && !(dwc_rd(DSTS) & DSTS_DEVCTRLHLT); i++) {
+		delay(1000);
+	}
+	ud_evlog(0xd0000005 | (i << 8));        /* tag 5: halted after i ms */
+	/* ep0 from scratch while halted, as at start-up: end whatever ep0 had going, re-init its config and SETUP */
+	for (unsigned e = 0; e < 2; e++) {
+		if (ud.xfer_active[e]) {
+			ud_epcmd(e, DEPCMD_ENDTRANSFER | DEPCMD_FORCERM | ((uint32_t)ud.xfer_res[e] << 16), 0, 0, 0);
+			ud.xfer_active[e] = false;
+		}
+	}
+	if (ud_epcmd(0, DEPCMD_DEPSTARTCFG, 0, 0, 0) ||
+	    ud_epcmd(0, DEPCMD_SETEPCONFIG, (0u << 1) | (512u << 3), (1u << 8) | (1u << 10) | (0u << 25), 0) ||
+	    ud_epcmd(0, DEPCMD_SETTRANSFRESOURCE, 1, 0, 0) ||
+	    ud_epcmd(1, DEPCMD_SETEPCONFIG, (0u << 1) | (512u << 3), (1u << 8) | (1u << 10) | (1u << 25), 0) ||
+	    ud_epcmd(1, DEPCMD_SETTRANSFRESOURCE, 1, 0, 0)) {
+		ud_evlog(0xd0000006);           /* tag 6: ep0 re-init failed */
+	}
+	dwc_wr(DALEPENA, 0x3);
+	ud_start_setup();
+	ud_sleep_ms(300);
+	dwc_wr(DCFG, dwc_rd(DCFG) & ~(0x7fu << 3));
+	dwc_wr(DCTL, dwc_rd(DCTL) | DCTL_RUN_STOP);
+	for (i = 0; i < 500 && (dwc_rd(DSTS) & DSTS_DEVCTRLHLT); i++) {
+		delay(1000);
+	}
+	ud.suspended = false;
+	ud.resume_at = ud.probe_at = 0;
+	ud.last_rx = mach_absolute_time();
+	printf("SWEET USB: reconnected (DSTS 0x%08x)\n", dwc_rd(DSTS));
+}
+
+/* ARP who-has 192.168.7.1 (the host side, as the live log assumes): any answer proves the link both ways. */
+static void
+ud_send_probe(void)
+{
+	static const uint8_t host_ip[4] = { 192, 168, 7, 1 };
+	uint8_t f[42], mac[ETHER_ADDR_LEN] = { 0 }, ip[4] = { 192, 168, 7, 2 };
+	mbuf_t m = NULL;
+	ifaddr_t *addrs = NULL;
+
+	if (ud.ifp == NULL) {
+		return;
+	}
+	(void)ifnet_lladdr_copy_bytes(ud.ifp, mac, sizeof(mac));
+	if (ifnet_get_address_list_family(ud.ifp, &addrs, AF_INET) == 0 && addrs != NULL) {
+		struct sockaddr_in sin;
+		if (addrs[0] != NULL && ifaddr_address(addrs[0], (struct sockaddr *)&sin, sizeof(sin)) == 0) {
+			memcpy(ip, &sin.sin_addr, 4);
+		}
+		ifnet_free_address_list(addrs);
+	}
+	memset(f, 0xff, 6);                     /* broadcast */
+	memcpy(f + 6, mac, 6);
+	f[12] = 0x08; f[13] = 0x06;             /* ARP */
+	f[14] = 0; f[15] = 1; f[16] = 0x08; f[17] = 0; f[18] = 6; f[19] = 4; f[20] = 0; f[21] = 1;
+	memcpy(f + 22, mac, 6);
+	memcpy(f + 28, ip, 4);
+	memset(f + 32, 0, 6);
+	memcpy(f + 38, host_ip, 4);
+	if (mbuf_gethdr(MBUF_DONTWAIT, MBUF_TYPE_DATA, &m) != 0) {
+		return;
+	}
+	memcpy(mbuf_data(m), f, sizeof(f));
+	mbuf_setlen(m, sizeof(f));
+	mbuf_pkthdr_setlen(m, sizeof(f));
+	ud.probes++;
+	ud.probe_tx_done = ud.tx_done;
+	ud.probe_at = mach_absolute_time();
+	ud_evlog(0xd0000003);                   /* tag 3: ARP probe sent */
+	(void)ud_if_output(ud.ifp, m);
+}
+
+/*
+ * Link watchdog, every 100 ms: with the data interface up, 60 s without a received frame (or 2 s after a resume) sends
+ * an ARP probe; no frame within 10 s of it means the host lost us (slept, replugged, or its driver stalled) -> soft
+ * reconnect. Unconfigured, nothing runs: a sleeping host is left alone until it enumerates again.
+ */
+static void
+ud_watch(void)
+{
+	if (ud.reconnect_req) {
+		ud.reconnect_req = 0;
+		ud_soft_reconnect("requested");
+		return;
+	}
+	if (!ud.watch || !ud.configured || ud.data_alt != 1 || ud.suspended) {
+		ud.probe_at = 0;
+		return;
+	}
+	/* bulk IN stuck (no XferComplete in 2 s): end it and go on; failing starts: reconnect */
+	lck_mtx_lock(ud.lock);
+	if (ud.tx_busy && ud_ms_since(ud.tx_started) > 2000) {
+		ud_epcmd(EP_TX, DEPCMD_ENDTRANSFER | DEPCMD_FORCERM | ((uint32_t)ud.xfer_res[EP_TX] << 16), 0, 0, 0);
+		ud.xfer_active[EP_TX] = false;
+		delay(200);
+		ud.tx_busy = false;
+		ud.tx_stalls++;
+		ud_evlog(0xd0000008);           /* tag 8: bulk IN stall ended */
+		ud_tx_kick_locked();
+	} else if (!ud.tx_busy && ud.txq_count) {
+		ud_tx_kick_locked();            /* retry after a failed start */
+	}
+	bool tx_broken = ud.tx_fails >= 3;
+	lck_mtx_unlock(ud.lock);
+	if (tx_broken) {
+		ud.tx_fails = 0;
+		ud.fails++;
+		ud_soft_reconnect("bulk IN start failing");
+		return;
+	}
+	if (ud.probe_at) {
+		/* answered = our frame went out (XferComplete) and something came back after it */
+		if (ud.last_rx > ud.probe_at && ud.tx_done > ud.probe_tx_done) {
+			ud.probe_at = 0;        /* answered */
+			ud.fails = 0;
+			ud_evlog(0xd0000004);   /* tag 4: probe answered */
+		} else if (ud_ms_since(ud.probe_at) > 10000) {
+			ud.fails++;
+			ud_soft_reconnect("probe unanswered");
+		}
+		return;
+	}
+	/* after a resume or SET_INTERFACE: probe in 3 s, later ones back off (3, 6, 12 .. 60 s) if reconnects keep failing */
+	uint64_t wait = ud.fails < 5 ? 3000ull << ud.fails : 60000;
+	if ((ud.resume_at && ud_ms_since(ud.resume_at) > wait) || ud_ms_since(ud.last_rx) > 60000) {
+		ud.resume_at = 0;
+		ud_send_probe();
+	}
+}
