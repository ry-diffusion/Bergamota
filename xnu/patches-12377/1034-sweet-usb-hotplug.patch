 static void
 ud_event(uint32_t ev)
 {
@@ -926,6 +960,21 @@ ud_event(uint32_t ev)
 		} else if (type == 0) {
 			printf("SWEET USB: disconnect\n");
 			ud_bus_reset("disconnect");
+		} else if (type == 3 || type == 6) {    /* link state change / suspend: link state in [19:16] */
+			uint32_t link = (ev >> 16) & 0xf;
+			if (link == 3 && !ud.suspended) {       /* U3 / L2: host suspended the bus */
+				ud.suspended = true;
+				ud.suspends++;
+				printf("SWEET USB: suspended\n");
+			} else if (link == 0 && ud.suspended) {  /* U0 / L0 again */
+				ud_resumed("link on");
+			}
+		} else if (type == 4) {         /* wakeup (resume signalling) */
+			ud_resumed("wakeup");
+		} else if (type == 9) {         /* erratic error: start over */
+			ud.errors++;
+			printf("SWEET USB: erratic error, reconnecting\n");
+			ud.reconnect_req = 1;
 		}
 		return;
 	}
@@ -989,6 +1038,104 @@ ud_event(uint32_t ev)
 	}
 }
 
+/*
+ * Soft disconnect + reconnect (Linux dwc3 pullup off/on without the core reset beryllium cannot take): the pull-up goes
+ * away for 300 ms, so the host sees an unplug and enumerates the phone from scratch (reset, SET_CONFIGURATION,
+ * SET_INTERFACE, NETWORK_CONNECTION). Runs on ud_thread, between event batches.
+ */
+static void
+ud_soft_reconnect(const char *why)
+{
+	int i;
+	ud.reconnects++;
+	printf("SWEET USB: soft reconnect #%u (%s)\n", ud.reconnects, why);
+	ud_bus_reset("soft disconnect");
+	dwc_wr(DCTL, dwc_rd(DCTL) & ~DCTL_RUN_STOP);
+	for (i = 0; i < 500 && !(dwc_rd(DSTS) & DSTS_DEVCTRLHLT); i++) {
+		delay(1000);
+	}
+	ud_sleep_ms(300);
+	dwc_wr(DCFG, dwc_rd(DCFG) & ~(0x7fu << 3));
+	dwc_wr(DCTL, dwc_rd(DCTL) | DCTL_RUN_STOP);
+	for (i = 0; i < 500 && (dwc_rd(DSTS) & DSTS_DEVCTRLHLT); i++) {
+		delay(1000);
+	}
+	ud.suspended = false;
+	ud.resume_at = ud.probe_at = 0;
+	ud.last_rx = mach_absolute_time();
+	printf("SWEET USB: reconnected (DSTS 0x%08x)\n", dwc_rd(DSTS));
+}
+
+/* ARP who-has 192.168.7.1 (the host side, as the live log assumes): any answer proves the link both ways. */
+static void
+ud_send_probe(void)
+{
+	static const uint8_t host_ip[4] = { 192, 168, 7, 1 };
+	uint8_t f[42], mac[ETHER_ADDR_LEN] = { 0 }, ip[4] = { 192, 168, 7, 2 };
+	mbuf_t m = NULL;
+	ifaddr_t *addrs = NULL;
+
+	if (ud.ifp == NULL) {
+		return;
+	}
+	(void)ifnet_lladdr_copy_bytes(ud.ifp, mac, sizeof(mac));
+	if (ifnet_get_address_list_family(ud.ifp, &addrs, AF_INET) == 0 && addrs != NULL) {
+		struct sockaddr_in sin;
+		if (addrs[0] != NULL && ifaddr_address(addrs[0], (struct sockaddr *)&sin, sizeof(sin)) == 0) {
+			memcpy(ip, &sin.sin_addr, 4);
+		}
+		ifnet_free_address_list(addrs);
+	}
+	memset(f, 0xff, 6);                     /* broadcast */
+	memcpy(f + 6, mac, 6);
+	f[12] = 0x08; f[13] = 0x06;             /* ARP */
+	f[14] = 0; f[15] = 1; f[16] = 0x08; f[17] = 0; f[18] = 6; f[19] = 4; f[20] = 0; f[21] = 1;
+	memcpy(f + 22, mac, 6);
+	memcpy(f + 28, ip, 4);
+	memset(f + 32, 0, 6);
+	memcpy(f + 38, host_ip, 4);
+	if (mbuf_gethdr(MBUF_DONTWAIT, MBUF_TYPE_DATA, &m) != 0) {
+		return;
+	}
+	memcpy(mbuf_data(m), f, sizeof(f));
+	mbuf_setlen(m, sizeof(f));
+	mbuf_pkthdr_setlen(m, sizeof(f));
+	ud.probes++;
+	ud.probe_at = mach_absolute_time();
+	(void)ud_if_output(ud.ifp, m);
+}
+
+/*
+ * Link watchdog, every 100 ms: with the data interface up, 60 s without a received frame (or 2 s after a resume) sends
+ * an ARP probe; no frame within 10 s of it means the host lost us (slept, replugged, or its driver stalled) -> soft
+ * reconnect. Unconfigured, nothing runs: a sleeping host is left alone until it enumerates again.
+ */
+static void
+ud_watch(void)
+{
+	if (ud.reconnect_req) {
+		ud.reconnect_req = 0;
+		ud_soft_reconnect("requested");
+		return;
+	}
+	if (!ud.watch || !ud.configured || ud.data_alt != 1 || ud.suspended) {
+		ud.probe_at = 0;
+		return;
+	}
+	if (ud.probe_at) {
+		if (ud.last_rx > ud.probe_at) {
+			ud.probe_at = 0;        /* answered */
+		} else if (ud_ms_since(ud.probe_at) > 10000) {
+			ud_soft_reconnect("probe unanswered");
+		}
+		return;
+	}
+	if ((ud.resume_at && ud_ms_since(ud.resume_at) > 2000) || ud_ms_since(ud.last_rx) > 60000) {
+		ud.resume_at = 0;
+		ud_send_probe();
+	}
+}
+
