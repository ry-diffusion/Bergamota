 }
+/* kern.sweet_usb: link state and counters (read); kern.sweet_usb_reconnect=1: soft reconnect now. */
+static int
+ud_stats_sysctl SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	char buf[400];
+	int n = snprintf(buf, sizeof(buf),
+	    "configured=%d alt=%u suspended=%d rx=%llu tx=%llu last_rx_ms=%llu resets=%u reconnects=%u suspends=%u "
+	    "wakeups=%u probes=%u errors=%u dev_events=%u events=%u watch=%d DSTS=0x%08x",
+	    ud.configured, ud.data_alt, ud.suspended, ud.rx_frames, ud.tx_frames, ud.dwc ? ud_ms_since(ud.last_rx) : 0ULL,
+	    ud.resets, ud.reconnects, ud.suspends, ud.wakeups, ud.probes, ud.errors, ud.dev_events, ud.events, ud.watch,
+	    ud.dwc ? dwc_rd(DSTS) : 0);
+	return SYSCTL_OUT(req, buf, (size_t)n + 1);
+}
+SYSCTL_PROC(_kern, OID_AUTO, sweet_usb, CTLTYPE_STRING | CTLFLAG_RD | CTLFLAG_LOCKED, 0, 0, ud_stats_sysctl, "A",
+    "USB gadget link state and counters (kernel 1034)");
+
+static int
+ud_reconnect_sysctl SYSCTL_HANDLER_ARGS
+{
+#pragma unused(arg1, arg2)
+	int v = 0, err = sysctl_handle_int(oidp, &v, 0, req);
+	if (err || req->newptr == USER_ADDR_NULL) {
+		return err;
+	}
+	if (v != 1 || !ud.dwc) {
+		return EINVAL;
+	}
+	ud.reconnect_req = 1;
+	return 0;
+}
+SYSCTL_PROC(_kern, OID_AUTO, sweet_usb_reconnect, CTLTYPE_INT | CTLFLAG_WR | CTLFLAG_LOCKED, 0, 0, ud_reconnect_sysctl, "I",
+    "1: soft disconnect and reconnect the USB gadget");
 #endif /* ARM64_BOARD_CONFIG_SWEET */
