 				    (((ev >> 1) & 0x1f) == EP_RX || ((ev >> 1) & 0x1f) == EP_TX);
-				if (ud.events++ < 200 || (!routine && ud.events < 5000)) {
+				if (ud.events++ < 200 || ((ev & 1) && ud.dev_events++ < 2000) || (!routine && ud.events < 5000)) {
 					printf("SWEET USB: event 0x%08x\n", ev);
